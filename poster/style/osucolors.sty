%==============================================================================
% osucolors.sty -- Oregon State University brand colors
%   Shared by the OSU/Soundbendor slide template (sty/osu.sty) and, if you like,
%   the poster template. One file, one source of truth for the palette.
%
%   Usage:  \usepackage{sty/osucolors}     (slides)
%           \usepackage{style/osucolors}   (poster)
%   Keep both copies identical. No \ProvidesPackage, so it loads from any folder.
%==============================================================================
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{xcolor}

%--- Primary ------------------------------------------------------------------
\definecolor{beaver}      {HTML}{D73F09}   % Beaver Orange
\definecolor{paddletail}  {HTML}{000000}   % Paddletail Black
\definecolor{bucktooth}   {HTML}{FFFFFF}   % Bucktooth White

%--- Secondary: normal --------------------------------------------------------
\definecolor{pinestand}   {HTML}{4A773C}   % Pine Stand
\definecolor{hightide}    {HTML}{00859B}   % High Tide
\definecolor{luminance}   {HTML}{FFB500}   % Luminance
\definecolor{stratosphere}{HTML}{006A8E}   % Stratosphere

%--- Secondary: light ---------------------------------------------------------
\definecolor{reindeermoss}{HTML}{C4D6A4}   % Reindeer Moss
\definecolor{seafoam}     {HTML}{B8DDE1}   % Seafoam
\definecolor{candela}     {HTML}{FDD26E}   % Candela
\definecolor{moondust}    {HTML}{C6DAE7}   % Moondust

%--- Secondary: dark ----------------------------------------------------------
