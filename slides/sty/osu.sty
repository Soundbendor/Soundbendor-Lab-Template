% Use \begin{algorithm}[H] inside frames (floats do not float in beamer).
\SetAlFnt{\small\sffamily}
\SetAlCapFnt{\small\sffamily}
\SetAlCapNameFnt{\small\sffamily\bfseries\scshape\color{beaver}}  % algorithm title
\newcommand{\osu@algfunc}[1]{\textsc{\textcolor{beaver}{#1}}}
\SetFuncSty{osu@algfunc}   % names from \SetKwFunction, e.g. \SetKwFunction{FTrain}{Train}
\newcommand{\osu@algkw}[1]{\textbf{\textcolor{stratosphere}{#1}}}
\SetKwSty{osu@algkw}
\SetCommentSty{osu@algcomment}
\newcommand{\osu@algcomment}[1]{\textcolor{pinestand}{\textit{#1}}}
\renewcommand{\thealgocf}{}
\NoCaptionOfAlgo
\DontPrintSemicolon
\SetKwInOut{Input}{inputs}
\SetKwInOut{Local}{local}
\SetKwInOut{Output}{output}
