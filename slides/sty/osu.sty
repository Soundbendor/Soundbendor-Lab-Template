}

%==============================================================================
% 12. Code listings
%==============================================================================
% Every lstlisting is drawn in a soft grey rounded box (frame needs [fragile]).
% Escape to LaTeX inside code with (* ... *), e.g. (*\term{here}*).
% Styles: \begin{lstlisting}[style=numbered] adds line numbers.
\lstdefinestyle{osu}{
  basicstyle=\scriptsize\ttfamily,
  keywordstyle=\color{stratosphere}\bfseries,
  stringstyle=\color{solarflare},
  commentstyle=\color{pinestand}\itshape,
  identifierstyle=\color{paddletail!85},
  emphstyle=\color{beaver}\bfseries,
  numberstyle=\tiny\color{crater},
  showstringspaces=false,
  upquote=true,
  columns=flexible, keepspaces=true,
  tabsize=4,
  escapeinside={(*}{*)},
  aboveskip=0pt, belowskip=0pt,
  abovecaptionskip=0pt, belowcaptionskip=6pt,
}
\lstdefinestyle{numbered}{style=osu, numbers=left, numbersep=6pt, xleftmargin=12pt}
\lstset{style=osu}
\edef\osu@tmp{\noexpand\lstset{language=\osu@code}}\osu@tmp

\tcbset{osucode/.style={enhanced, arc=4pt, boxrule=0.4pt,
  colback=coastline!15, colframe=coastline!80, left=4pt, right=4pt,
  top=2pt, bottom=2pt, before skip=4pt, after skip=4pt,
  drop fuzzy shadow=black!30}}
\BeforeBeginEnvironment{lstlisting}{\begin{tcolorbox}[osucode]}
\AfterEndEnvironment{lstlisting}{\end{tcolorbox}}
% Whole file:  \codefile{code/demo.py}  or  \codefile[style=numbered]{...}
\newcommand{\codefile}[2][]{%
  \begin{tcolorbox}[osucode]\lstinputlisting[#1]{#2}\end{tcolorbox}}

