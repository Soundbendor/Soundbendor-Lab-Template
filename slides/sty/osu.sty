%==============================================================================
% 14. Bibliography (applied only if you load biblatex)
%==============================================================================
% Recommended:  \usepackage[style=ieee]{biblatex}  \addbibresource{refs.bib}
%   - numbered entries [1], a little space between them
%   - authors bold, titles in Stratosphere (IEEE quotes kept), DOIs/URLs linked
%   - in-text citations small, bold, Beaver
\newcommand{\osu@bibnames}{%   bold author names in the reference list
  \renewcommand*{\mkbibnamegiven}[1]{\textbf{##1}}%
  \renewcommand*{\mkbibnamefamily}[1]{\textbf{##1}}}
\AtEndPreamble{%
  \@ifpackageloaded{biblatex}{%
    \setbeamertemplate{bibliography item}{\ifdefined\insertbiblabel\insertbiblabel\fi}
    \setbeamerfont{bibliography item}{size=\tiny, series=\bfseries}
    \setbeamerfont{bibliography entry author}{size=\tiny, series=\bfseries}
    \setbeamerfont{bibliography entry title}{size=\tiny}
    \setbeamerfont{bibliography entry location}{size=\tiny}
    \setbeamerfont{bibliography entry note}{size=\tiny}
    \setbeamercolor{bibliography item}{fg=beaver}
    \setbeamercolor{bibliography entry author}{fg=paddletail}
    \setbeamercolor{bibliography entry title}{fg=stratosphere}
    \setbeamercolor{bibliography entry location}{fg=paddletail!70}
    \setbeamercolor{bibliography entry note}{fg=paddletail!70}
    \setlength{\bibitemsep}{4pt}%
    \AtBeginBibliography{\tiny\osu@bibnames}%
    \AtEveryCite{\footnotesize\bfseries\color{beaver}}%
  }{}%
}

